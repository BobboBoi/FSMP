[gd_scene load_steps=3 format=3 uid="uid://muwqglgsr75o"]

[sub_resource type="GDScript" id="GDScript_5sbud"]
resource_name = "QueueSelectionContent"
script/source = "extends HBoxContainer

func Refresh(selection : QueueSelection, fade := true) -> void:
	%Name.text = selection.data.name
	%Artist.text = selection.data.artist
	
	if !fade: return
	
	modulate = Color(1,1,1,0)
	var tween := create_tween()
	tween.tween_property(self,\"modulate\",Color(1,1,1,1),0.15)
"

[sub_resource type="StyleBoxEmpty" id="StyleBoxEmpty_qw5i3"]

[node name="Cont" type="HBoxContainer"]
mouse_filter = 2
script = SubResource("GDScript_5sbud")

[node name="SpinParent" type="Control" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(50, 50)
layout_mode = 2
mouse_filter = 2

[node name="VSeparator" type="VSeparator" parent="."]
layout_mode = 2
mouse_filter = 2
