[sub_resource type="GDScript" id="GDScript_kabur"]
resource_name = "QuickSearchBar"
script/source = "extends SearchBar

@onready var timer = Timer.new()
var prevText := \"\"

func _ready() -> void:
	timer.wait_time = 0.5
	add_child(timer)
	
	timer.timeout.connect(RefreshSearch)

func Filter() -> void:
	super()
	if text == \"\" and !timer.is_stopped():
		RefreshSearch()
		timer.stop()
	
	elif text != \"\" and timer.is_stopped():
		RefreshSearch()
		timer.start()

func RefreshSearch() -> void:
	if prevText == text: return
	prevText = text
	owner.call(\"Reload\",text)
"

